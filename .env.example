# =============================================================================
# Manganer - example.env
# Copia a .env y personaliza. NUNCA commitees tu .env real.
# =============================================================================

# === PUERTOS Y RED ===
API_PORT=8000

# === RUTAS LOCALES (Windows: usa barras forward / o dobles backslash \\) ===
# 🔧 IMPORTANTE: Cambia estas rutas a tu estructura real
DATA_PATH=./data
LIBRARY_PATH=./library
STATIC_PATH=./app/static
LOGS_PATH=./logs

# Ejemplos para Windows:
# LIBRARY_PATH=E:/01_Multimedia/OMNA/Suwayomi/local
# DATA_PATH=C:/Users/beehr/Manganer/data

# === RENDIMIENTO ===
WORKERS=4
API_MEMORY_LIMIT=1.5G
WORKER_MEMORY_LIMIT=1.5G
REDIS_MEMORY_LIMIT=512M
REDIS_MAXMEMORY=256mb

# === LOGGING ===
CELERY_LOGLEVEL=info
DEBUG=false

# === IDIOMA Y TRADUCCIÓN ===
DEFAULT_LANG=es

# === API KEYS (OPCIONAL - obtener en sitios oficiales) ===
# DeepL: https://www.deepl.com/pro-api
DEEPL_API_KEY=

# AniList: https://anilist.co/settings/developer
ANILIST_CLIENT_ID=

# MyAnimeList: https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# === OPDS (Catálogo para lectores) ===
OPDS_PUBLIC=true
OPDS_RATE_LIMIT_PER_IP=60

# === SEGURIDAD (descomentar si OPDS_PUBLIC=false) ===
# OPDS_BASIC_AUTH_USER=admin
# OPDS_BASIC_AUTH_PASSWORD=cambiar_esta_contraseña